{
    "spec_version": "v1.4",
    "identifier": "OffworldSpaceCenters",
    "name": "Offworld Space Centers",
    "abstract": "Turn Kerbal Konstructs bases on any body into Space Centers: stock recovery nearby, a real Space Center scene at the base, your own buildings as facilities, Tracking Station icons",
    "author": "Fino",
    "license": "MIT",
    "$kref": "#/ckan/github/<your-github-name>/OffworldSpaceCenters",
    "$vref": "#/ckan/ksp-avc",
    "resources": {
        "homepage": "https://github.com/<your-github-name>/OffworldSpaceCenters",
        "repository": "https://github.com/<your-github-name>/OffworldSpaceCenters",
        "bugtracker": "https://github.com/<your-github-name>/OffworldSpaceCenters/issues"
    },
    "tags": [
        "plugin",
        "buildings",
        "career"
    ],
    "depends": [
        { "name": "KerbalKonstructs" },
        { "name": "Harmony2" },
        { "name": "ModuleManager" }
    ],
    "install": [
        {
            "find": "OffworldSpaceCenters",
            "install_to": "GameData"
        }
    ]
}
